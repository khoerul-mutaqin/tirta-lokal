<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.rule" id="x_granted_users_ids">
        <field name="name">res.partner granted users</field>
        <field name="model_id" ref="model_res_partner" />
        <field name="global" eval="True" />
        <field
            name="domain_force"
        >['|',('id', '=', user.partner_id.id),('x_granted_users_ids', 'in', user.id)]</field>
    </record>


    <!-- View res.partner form -->
    <record id="view_res_partner_form" model="ir.ui.view">
        <field name="name">view.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
              <xpath expr="//form/sheet/notebook" position="inside">
                <page string="User Access" name="studio_page_granted_user" groups="sales_team.group_sale_manager,base.group_system">
                  <field name="x_granted_users_ids" widget="one2many_list" nolabel="1" invisible="False">
                    <list string="Granted Users" editable="bottom">
                      <field name="name"/>
                    </list>
                  </field>
                </page>    
              </xpath> 
         </field>
    </record>


</odoo>
