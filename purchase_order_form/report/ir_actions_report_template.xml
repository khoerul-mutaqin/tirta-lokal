                        <t t-set="tahun_order" t-value="doc.date_approve.strftime('%Y')" />
                        <t t-set="bulan_order_display" t-value="doc.date_approve.strftime('%B')" />
                    </t> -->
                <t t-if="doc.x_studio_created_on">
                    <t t-set="formatted_date" t-value="doc.x_studio_created_on.strftime('%d %B %Y')"/>
                    <t t-set="day_order" t-value="doc.x_studio_created_on.strftime('%d')"/>
                    <t t-set="bulan_order" t-value="doc.x_studio_created_on.strftime('%m')"/>
                    <t t-set="tahun_order" t-value="doc.x_studio_created_on.strftime('%Y')"/>
                    <t t-set="bulan_order_display" t-value="doc.x_studio_created_on.strftime('%B')"/>
                    </t>
                <t t-if="doc.date_planned">
                    <t t-set="formatted_date_planned" t-value="doc.date_planned.strftime('%d %B %Y')"/>
                    <t t-set="day_planned" t-value="doc.date_planned.strftime('%d')"/>
                    <t t-set="bulan_planned" t-value="doc.date_planned.strftime('%m')"/>
                    <t t-set="tahun_planned" t-value="doc.date_planned.strftime('%Y')"/>
                    <t t-set="bulan_planned_display" t-value="doc.date_planned.strftime('%B')"/>
                    </t>
                <!-- <div class="backgroundimage" style="position:absolute;opacity:1;font-size:3em;width:100%;height:100%;z-index:-1;border: 1px solid black;object-fit: cover;"> -->
                <!-- <img src="data:image/png;base64,"  style="width: 200px; height: 200px; object-fit: cover;"/> -->
                <!-- <img src="" style="width: 100%; height: 100%; object-fit: cover;"/> -->
                <!-- <div class="backgroundimage" style="position:absolute;opacity:1;font-size:3em;height:100%;z-index:-1;border: 1px solid black;object-fit: cover;">
                        <img t-att-src="image_data_uri(company.x_studio_binary_field_6h7_1hrq3q415)"/>
                    </div> -->
                <!-- <div class="backgroundimage" style="position:absolute;opacity:1;font-size:3em;width:98%;height:99%;z-index:-1;border: 1px solid black;overflow: hidden;">
                        <img t-att-src="image_data_uri(company.x_studio_binary_field_6h7_1hrq3q415)" style="width: 100%;"/>
                    </div> -->
                <!-- <div class="backgroundimage" style="position:absolute;opacity:1;font-size:3em;width:98%;height:99%;z-index:-1;overflow: hidden;">
                        <img t-att-src="image_data_uri(company.x_studio_binary_field_6h7_1hrq3q415)" style="width: 100%;"/>
                    </div> -->
                <!-- Setting up in header repeated in each page -->
                <!-- <div class="header" style="height: 180px"> -->
                <!-- logo perusahaan di kanan atas -->
                <!-- <img t-att-src="image_data_uri(company.logo)" style="max-height: 180px;float: right;" /> -->
                <!-- </div> -->
                <!-- https://stackoverflow.com/questions/39559665/css-background-image-shrink-to-fit-fixed-size-div -->
                <style>
                        .bg_image {
                        background-position: center;
                        background-repeat: no-repeat;
                        -webkit-background-size: contain;
                        -moz-background-size: contain;
                        -o-background-size: contain;
                        background-size: cover;

                        height: 100%;
                        width: 100%;
                        }
                    </style>
                <!-- <div class="article"> -->
                <div class="page" style="padding: 0px; margin: 0px;">
                    <div class="bg_image" t-att-style="'height: 1325px; width: 100%; position: absolute; opacity: 1; z-index: -1; background-image: url(' + image_data_uri(company.x_studio_binary_field_6h7_1hrq3q415) + ');'">
                        </div>
                    <!-- <t t-set="locale">id_ID.UTF-8</t>
                        <t t-esc="doc.date_order.strftime('%d %B %Y')"/> -->
                    <!-- karena setelah mencari kemana-mana tidak ditemukan cara memformat
                            tampilan tanggal menjadi : 01 Agustus 2024 (dalam bahasa indonesia)
                            maka digunakan cara manual, bila lang = 'id_ID' maka diterjemahkan
                            manual bulannya -->
                    <t t-if="lang == 'id_ID'">
                        <t t-if="bulan_order == '01'">
                            <t t-set="bulan_order_display" t-value="'Januari'"/>
                            </t>
                        <t t-elif="bulan_order == '02'">
                            <t t-set="bulan_order_display" t-value="'Februari'"/>
                            </t>
                        <t t-elif="bulan_order == '03'">
                            <t t-set="bulan_order_display" t-value="'Maret'"/>
                            </t>
                        <t t-elif="bulan_order == '04'">
                            <t t-set="bulan_order_display" t-value="'April'"/>
                            </t>
                        <t t-elif="bulan_order == '05'">
                            <t t-set="bulan_order_display" t-value="'Mei'"/>
                            </t>
                        <t t-elif="bulan_order == '06'">
                            <t t-set="bulan_order_display" t-value="'Juni'"/>
                            </t>
                        <t t-elif="bulan_order == '07'">
                            <t t-set="bulan_order_display" t-value="'Juli'"/>
                            </t>
                        <t t-elif="bulan_order == '08'">
                            <t t-set="bulan_order_display" t-value="'Agustus'"/>
                            </t>
                        <t t-elif="bulan_order == '09'">
                            <t t-set="bulan_order_display" t-value="'September'"/>
                            </t>
                        <t t-elif="bulan_order == '10'">
                            <t t-set="bulan_order_display" t-value="'Oktober'"/>
                            </t>
                        <t t-elif="bulan_order == '11'">
                            <t t-set="bulan_order_display" t-value="'November'"/>
                            </t>
                        <t t-elif="bulan_order == '12'">
                            <t t-set="bulan_order_display" t-value="'Desember'"/>
                            </t>
                        <t t-set="formatted_date" t-value="day_order + ' ' + bulan_order_display + ' ' + tahun_order"/>
                        <t t-if="bulan_planned == '01'">
                            <t t-set="bulan_planned_display" t-value="'Januari'"/>
                            </t>
                        <t t-elif="bulan_planned == '02'">
                            <t t-set="bulan_planned_display" t-value="'Februari'"/>
                            </t>
                        <t t-elif="bulan_planned == '03'">
                            <t t-set="bulan_planned_display" t-value="'Maret'"/>
                            </t>
                        <t t-elif="bulan_planned == '04'">
                            <t t-set="bulan_disbulan_planned_displayplay" t-value="'April'"/>
                            </t>
                        <t t-elif="bulan_planned == '05'">
                            <t t-set="bulan_planned_display" t-value="'Mei'"/>
                            </t>
                        <t t-elif="bulan_planned == '06'">
                            <t t-set="bulan_planned_display" t-value="'Juni'"/>
                            </t>
                        <t t-elif="bulan_planned == '07'">
                            <t t-set="bulan_planned_display" t-value="'Juli'"/>
                            </t>
                        <t t-elif="bulan_planned == '08'">
                            <t t-set="bulan_planned_display" t-value="'Agustus'"/>
                            </t>
                        <t t-elif="bulan_planned == '09'">
                            <t t-set="bulan_planned_display" t-value="'September'"/>
                            </t>
                        <t t-elif="bulan_planned == '10'">
                            <t t-set="bulan_planned_display" t-value="'Oktober'"/>
                            </t>
                        <t t-elif="bulan_planned == '11'">
                            <t t-set="bulan_planned_display" t-value="'November'"/>
                            </t>
                        <t t-elif="bulan_planned == '12'">
                            <t t-set="bulan_planned_display" t-value="'Desember'"/>
                            </t>
                        <t t-set="formatted_date_planned" t-value="day_planned + ' ' + bulan_planned_display + ' ' + tahun_planned"/>
                        </t>
                    <!-- <t t-esc="lang"/>
                        <t t-esc="bulan_order"/>
                        <t t-esc="bulan_order_display"/>
                        <t t-esc="bulan_planned_display"/> -->
                    <!-- Judul : PURCHASE ORDER -->
                    <div style="height: 130px; text-align: center; line-height: 130px; padding-top: 120px;">
                        <span style="font-weight: bold; text-decoration: underline; font-size:36px; vertical-align: middle;">
                                PURCHASE ORDER
                            </span>
                    </div>
                    <!-- Informasi bon purchase order -->
                    <table style="width:95%; border-color: transparent; margin-left: auto; margin-right: auto;">
                        <tr>
                            <td style="width: 51%">
                                </td>
                            <td>
                                <strong style="margin-left: 3px;">Kepada Yth:</strong>
                            </td>
                        </tr>
                        <tr>
                            <!-- kolom nomor dokumen, tanggal, no. PO -->
                            <td style="width: 51%">
                                <table style="width:100%;border-color: transparent;">
                                    <tr>
                                        <td style="width: 18%">
                                            <strong>No. Dok.</strong>
                                        </td>
                                        <td>
                                            <span>:</span>
                                            <span t-out="doc.x_studio_no_dok"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width: 18%">
                                            <strong>Tanggal</strong>
                                        </td>
                                        <td>
                                            <span>:</span>
                                            <span t-esc="formatted_date"/>
                                            <!-- <span t-esc="formatted_date_planned"/> -->
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width: 18%">
                                            <strong>No. PO.</strong>
                                        </td>
                                        <td>
                                            <span>:</span>
                                            <span t-out="doc.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width: 18%">
                                            <strong>No. SPB.</strong>
                                        </td>
                                        <td>
                                            <span>:</span>
                                            <span t-out="doc.origin"/>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                            <!-- kolom Kepada Yth. -->
                            <td style="vertical-align: top">
                                <table style="width:100%;border-color: transparent;">
                                    <tr>
                                        <td>
                                            <div>
                                                <span/>
                                                <strong t-out="doc.partner_id.commercial_company_name"/>
                                            </div>
                                            <div>
                                                <strong>Up.</strong>
                                                <strong t-out="doc.partner_id.name"/>
                                            </div>
                                            <div>
                                                <strong t-out="doc.partner_id.street"/>
                                            </div>
                                            <div>
                                                <strong t-out="doc.partner_id.city"/>
                                                <t t-if="doc.partner_id.state_id.name">
                                                    <span>,</span>
                                                    <strong t-out="doc.partner_id.state_id.name"/>
                                                </t>
                                            </div>
                                            <t t-if="doc.partner_id.phone">
                                                <strong>Telp :</strong>
                                                <span/>
                                                <strong t-out="doc.partner_id.phone"/>
                                            </t>
                                            <t t-if="doc.partner_id.email">
                                                <strong>Email :</strong>
                                                <span/>
                                                <strong t-out="doc.partner_id.email"/>
                                            </t>
                                        </td>
                                    </tr>
                                    <!-- <tr>
                                            <td>
                                                <t t-if="doc.partner_id.phone">
                                                    <strong>Telp.</strong>
                                                    <span></span><strong t-out="doc.partner_id.phone"/>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <t t-if="doc.partner_id.email">
                                                    <strong>Email</strong>
                                                    <span></span><strong t-out="doc.partner_id.email"/>
                                                </t>
                                            </td>
                                        </tr> -->
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td rowspan="1" colspan="2">
                                <strong style="margin-left: 3px;">Waktu Pembayaran</strong>
                                <span>:</span>
                                <span t-out="doc.payment_term_id.name"/>
                            </td>
                        </tr>
                    </table>
                    <div style="margin-top: 10px; margin-left: 25px;">
                        <span>Mohon dikirimkan barang sebagai berikut :</span>
                    </div>
                    <!-- heading tabel -->
                    <table style="width:95%; margin-left: auto; margin-right: auto; margin-top: 10px; padding: 0px; border-collapse: collapse;">
                        <tr>
                            <th style="height: 40px; width: 20%; vertical-align: middle; border-top: 1px solid black; border-left: 1px solid black; border-bottom: 1px solid black; padding: 0px; margin: 0px;">
                                <span>KUANTUM</span>
                            </th>
                            <th style="height: 40px; width: 40%; vertical-align: middle; border-right: 1px solid black; padding: 0px; margin: 0px; border-top: 1px solid black; border-left: 1px solid black; border-bottom: 1px solid black; ">
                                <span>NAMA BARANG</span>
                            </th>
                            <th style="height: 40px; width: 20%; vertical-align: middle; border-right: 1px solid black; padding: 0px; margin: 0px; border-top: 1px solid black; border-left: 1px solid black; border-bottom: 1px solid black;">
                                <div>HARGA</div>
                            </th>
                            <th style="height: 40px; width: 20%; vertical-align: middle; border-right: 1px solid black; padding: 0px; margin: 0px; border: 1px solid black;">
                                <div>TOTAL</div>
                            </th>
                        </tr>
                    </table>
                    <!-- <table style="width:100%; margin-top: 10px; padding: 0px; border-collapse: collapse;">
                            <tr>
                                <th style="height: 40px; width: 20%; vertical-align: middle; border: 1px solid black;">
                                    <span>KUANTUM</span>
                                </th>
                                <th style="height: 40px; width: 40%; vertical-align: middle; border: 1px solid black;">
                                    <span>NAMA BARANG</span>
                                </th>
                                <th style="height: 40px; width: 20%; vertical-align: middle; border: 1px solid black;">
                                    <div>HARGA</div>
                                </th>
                                <th style="height: 40px; width: 20%; vertical-align: middle; border: 1px solid black;">
                                    <div>TOTAL</div>
                                </th>
                            </tr>
                        </table> -->
                    <t t-set="page" t-value="1"/>
                    <t t-set="counter" t-value="1"/>
                    <!-- detil -->
                    <div t-foreach="doc.order_line" t-as="line">
                        <table style="width:95%; margin-left: auto; margin-right: auto; border-left: 1px solid black; border-bottom: 1px solid black;border-collapse: collapse;">
                            <tr>
                                <td style="width: 20%; border-right: 1px solid black; padding: 0px; margin: 0px;">
                                    <div style="text-align: center;">
                                        <span t-out="line.product_qty"/>
                                        <span/>
                                        <span t-out="line.product_uom.display_name"/>
                                    </div>
                                    <t t-if="line.x_studio_purchase_unit_of_measure">
                                        <t t-if="line.x_studio_purchase_unit_of_measure.name != line.product_uom.name">
                                            <!-- ini hanya muncul bila :
                                                - x_studio_purchase_unit_of_measure ada isinya, dan
                                                - isinya tidak sama dengan product_uom -->
                                            <div style="text-align: center;">
                                                <span t-out="line.x_studio_konversi"/>
                                                <span t-out="line.x_studio_purchase_unit_of_measure.display_name"/>
                                            </div>
                                        </t>
                                    </t>
                                </td>
                                <td style="width: 40%; border-right: 1px solid black; vertical-align: middle; padding: 10px;">
                                    <!-- <t t-out="line.name"/> -->
                                    <t t-out="line.product_id.name"/>
                                </td>
                                <td style="width: 20%; border-right: 1px solid black; vertical-align: middle; padding: 10px;">
                                    <table style="width: 100%;border-color: transparent;">
                                        <tr>
                                            <td style="width: 20px; text-align: right;">
                                                <span t-out="doc.currency_id.symbol"/>
                                            </td>
                                            <td style="text-align: right;">
                                                <span t-out="line.price_unit" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                                <td style="width: 20%; border-right: 1px solid black; vertical-align: middle; padding: 10px;">
                                    <table style="width: 100%;border-color: transparent;">
                                        <tr>
                                            <td style="width: 20px; text-align: right">
                                                <span t-out="doc.currency_id.symbol"/>
                                            </td>
                                            <td style="text-align: right;">
                                                <span t-out="line.price_subtotal" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                        <!-- untuk halaman 1, tiap 12 item berdasarkan ukuran kertas A4 utk style detil ini,
                                 harus pindah halaman
                                 untuk halaman berikutnya, 1 page dapat berisi 14 item -->
                        <t t-set="baris" t-value="0"/>
                        <t t-if="page &gt; 1">
                            <t t-set="baris" t-value="14"/>
                            </t>
                        <t t-else="">
                            <t t-set="baris" t-value="12"/>
                            </t>
                        <t t-if="counter == baris">
                            <t t-set="counter" t-value="1"/>
                            <t t-set="page" t-value="page + 1"/>
                            <!-- <p style="page-break-before:always;"> </p> -->
                            <div style="padding: 0px; margin: 0px; dislay: contents;page-break-before: always;"/>
                            <div class="bg_image" style="height: 1325px; width: 100%; position:absolute;opacity:1;z-index:-1;">
                                </div>
                            <!-- Judul : PURCHASE ORDER -->
                            <div style="height: 130px; text-align: center; line-height: 130px; padding-top: 120px;">
                                <span style="font-weight: bold; text-decoration: underline; font-size:36px; vertical-align: middle;">
                                        PURCHASE ORDER
                                    </span>
                            </div>
                            <table style="width:95%; margin-left: auto; margin-right: auto; margin-top: 20px; padding: 0px; border-collapse: collapse;">
                                <tr>
                                    <th style="height: 40px; width: 20%; vertical-align: middle; border-top: 1px solid black; border-left: 1px solid black; border-bottom: 1px solid black; padding: 0px; margin: 0px;">
                                        <span>KUANTUM</span>
                                    </th>
                                    <th style="height: 40px; width: 40%; vertical-align: middle; border-right: 1px solid black; padding: 0px; margin: 0px; border-top: 1px solid black; border-left: 1px solid black; border-bottom: 1px solid black; ">
                                        <span>NAMA BARANG</span>
                                    </th>
                                    <th style="height: 40px; width: 20%; vertical-align: middle; border-right: 1px solid black; padding: 0px; margin: 0px; border-top: 1px solid black; border-left: 1px solid black; border-bottom: 1px solid black;">
                                        <div>HARGA</div>
                                    </th>
                                    <th style="height: 40px; width: 20%; vertical-align: middle; border-right: 1px solid black; padding: 0px; margin: 0px; border: 1px solid black;">
                                        <div>TOTAL</div>
                                    </th>
                                </tr>
                            </table>
                        </t>
                        <t t-else="">
                            <t t-set="counter" t-value="counter + 1"/>
                            </t>
                    </div>
                    <!-- total total -->
                    <table style="width:95%; margin-left: auto; margin-right: auto; border-left: 1px solid black; border-bottom: 1px solid black; border-collapse: collapse;">
                        <tr>
                            <!-- ini 60.1 atau 60 sesuaikan dengan yg di atas, miring atau tidak -->
                            <t t-set="tax_labels" t-value="doc.get_all_tax_labels(doc)"/>
                            <t t-set="rowspan_count" t-value="len(tax_labels)"/>
                            <td t-att-rowspan="3+rowspan_count" style="width: 60%; border-right: 1px solid black; padding: 10px; margin: 0px; vertical-align: bottom; text-align: left;">
                                <t t-set="terus" t-value="true"/>
                                <t t-if="doc.date_order">
                                    <t t-set="dateorder" t-value="doc.date_order.strftime('%Y%m%d')"/>
                                    </t>
                                <t t-set="kurs_usd" t-value="0"/>
                                <t t-foreach="request.env['res.currency.rate'].search([])" t-as="obj">
                                    <!-- <t t-esc="obj.name"/><t t-esc="obj.inverse_company_rate"/> -->
                                    <t t-if="terus">
                                        <t t-if="obj.name">
                                            <t t-set="datekurs" t-value="obj.name.strftime('%Y%m%d')"/>
                                            <t t-if="obj.currency_id.name == 'USD'">
                                                <t t-if="dateorder &gt; datekurs">
                                                    <t t-set="terus" t-value="false"/>
                                                    <t t-set="kurs_usd" t-value="obj.inverse_company_rate"/>
                                                    </t>
                                                <t t-else="">
                                                    </t>
                                            </t>
                                            <t t-else="">
                                                </t>
                                        </t>
                                    </t>
                                </t>
                                <div style="height: 100%;">
                                    <t t-if="doc.currency_id.name != 'IDR'">
                                        <div>
                                            <span>Kurs 1 USD =</span>
                                            <span>
                                                <t t-out="doc.currency_id.symbol"/>
                                            </span>
                                            <span t-esc="kurs_usd" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/>
                                        </div>
                                    </t>
                                    <div>
                                        <span>Waktu Pengiriman :</span>
                                        <span t-esc="formatted_date_planned"/>
                                    </div>
                                    <div>
                                        <span t-out="doc.x_studio_keterangan"/>
                                    </div>
                                </div>
                            </td>
                            <td style="width: 20%; border-right: 1px solid black; vertical-align: middle; padding: 10px;">
                                    Jumlah Harga Beli
                                </td>
                            <td style="width: 20%; border-right: 1px solid black; vertical-align: middle; padding: 10px;">
                                <table style="width: 100%;border-color: transparent;">
                                    <tr>
                                        <td style="width: 20px; text-align: right">
                                            <span t-out="doc.currency_id.symbol"/>
                                        </td>
                                        <td style="text-align: right;">
                                            <!-- 2025, odoo berubah versi -->
                                            <!-- <span t-esc="tax['amount_untaxed']" t-options='{"widget": "float", "precision": 2}'/> -->
                                            <span t-esc="tax['base_amount']" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/>
                                        </td>
                                    </tr>
